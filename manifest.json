{
  "manifest_version": 2,
  "name": "KEGE Reader — fluid text + PiP",
  "short_name": "KegPipe",
  "version": "0.3.15",
  "description": "Компактные окна и читаемый текст на kompege.ru: таблицы по ширине окна, кнопки PiP у каждого номера задачи, вынос задачи в плавающее окно поверх всех окон, зум, автопрокрутка с клавиатуры.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kege-reader@j3ngoos.github.io",
      "strict_min_version": "126.0",
      "update_url": "https://j3ngoos.github.io/kege-reader/kege-reader-updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "https://kompege.ru/*",
    "<all_urls>",
    "storage"
  ],
  "background": {
    "scripts": [
      "bg.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://kompege.ru/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "lib/kp-render.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "lib/kp-render.js"
  ],
  "content_security_policy": "img-src * blob: data:; script-src 'self'; object-src 'self'"
}